# Rofa PHPNuxBill Stack Secrets
# Copy this file to .env and fill in strong random values before running docker compose.

# MySQL / MariaDB
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=rofa_nuxbill
MYSQL_USER=rofa_nuxbill
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# PHPNuxBill application database settings (must match MYSQL_* above)
DB_HOST=rofa-mysql
DB_NAME=rofa_nuxbill
DB_USER=rofa_nuxbill
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# FreeRADIUS client secret (must match clients.conf on RADIUS server and router config)
RADIUS_SECRET=CHANGE_ME_RADIUS_SECRET

# Internal URL used by FreeRADIUS REST module to reach PHPNuxBill
PHPNUXBILL_URL=http://rofa-phpnuxbill
